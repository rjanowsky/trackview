# personal ride data & regenerable outputs (not part of the tool).
# As of the per-user-home change these now live under the data dir
# (~/.trackview, or $TRACKVIEW_HOME) -- OUTSIDE this repo, so these patterns are
# vestigial but kept defensively: they still catch a run pointed at the repo via
# TRACKVIEW_HOME=$PWD, or a tools/ helper's in-repo inputs.
gpx/
gc/
fit/

# the tools/ helpers' personal inputs + their regenerable dumps:
#   *.fit            -> the ride exports being inspected (like fit/)
#   *_records.json   -> dumped by tools/garmin_fit_reader.py (like output/)
tools/*.fit
tools/*_records.json
